# Copy to .env.local (web) — never commit the filled file.
# The workspace .gitignore already excludes **/.env and **/.env.*

# Supabase — Postgres connection string, via the pooler for serverless
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres

# Supabase project, public values (safe in the browser) — also what powers login
# (/login, /portfolio). Email/password sign-up works with nothing further; Google
# sign-in additionally needs the Google provider turned on in the Supabase dashboard
# (Authentication → Providers → Google, with a Google Cloud OAuth client — same kind of
# one-time console setup as the Maps key below), not a new env var here.
#
# Without these two, login/portfolio show "not configured" instead of breaking — the
# report on /analyse works exactly the same either way; login only adds a portfolio.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — bypasses RLS. ONLY for the ingestion job, never in a request path.
SUPABASE_SERVICE_ROLE_KEY=

# Mobile: where the Hono API lives. Use your LAN IP for a device on the same network.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Maps — the real basemap on /map. PUBLIC by necessity: a browser map key is
# visible to anyone with dev tools, which is why Google's guidance is to RESTRICT it by
# HTTP referrer in the Cloud console, not to hide it. Restrict it before you ship.
#
# Requires a billing account. Without this key the map falls back to the schematic
# outlines and says so — the app still runs with zero configuration.
#   console.cloud.google.com → APIs & Services → enable "Maps JavaScript API"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Claude — powers the "ask advice" chat panel. SERVER-ONLY: no NEXT_PUBLIC_ prefix,
# because unlike the Maps key this one has no per-request restriction you can set in a
# console — anyone who reads it can spend against your account. It stays inside
# packages/api's Hono handler and never reaches the browser bundle.
#
# Without this key the chat button still renders — it just tells you, inline, that
# the assistant isn't configured yet. Same "the app must survive not having one"
# rule as the Maps key and DATABASE_URL.
#   console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=